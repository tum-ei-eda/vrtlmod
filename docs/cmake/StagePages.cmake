function(canonical_directory path output)
    # Older CMake versions normalize '..' before following symlinks.
    string(REPLACE "\\" "/" components "${path}")
    if(components MATCHES "(^|/)\\.\\.(/|$)")
        message(FATAL_ERROR "Refusing to stage documentation: use paths without '..' components: '${path}'")
    endif()
    get_filename_component(existing "${path}" ABSOLUTE)
    set(suffix "")
    while(NOT EXISTS "${existing}")
        get_filename_component(name "${existing}" NAME)
        get_filename_component(parent "${existing}" DIRECTORY)
        if(parent STREQUAL existing)
            message(FATAL_ERROR "Cannot resolve documentation path '${path}'")
        endif()
        set(suffix "/${name}${suffix}")
        set(existing "${parent}")
    endwhile()
    get_filename_component(resolved "${existing}" REALPATH)
    get_filename_component(resolved "${resolved}${suffix}" ABSOLUTE)
    set(${output} "${resolved}" PARENT_SCOPE)
endfunction()

function(reject_overlap first second description)
    # Include the directory separator so sibling names such as site/site-old are safe.
    foreach(variable IN ITEMS first second)
        if(NOT "${${variable}}" MATCHES "/$")
            string(APPEND ${variable} "/")
        endif()
    endforeach()
    string(FIND "${first}" "${second}" first_in_second)
    string(FIND "${second}" "${first}" second_in_first)
    if(first_in_second EQUAL 0 OR second_in_first EQUAL 0)
        message(FATAL_ERROR "Refusing to stage documentation: output overlaps ${description}: '${first}' and '${second}'")
    endif()
endfunction()

foreach(variable IN ITEMS SITE_SOURCE_DIR DOXYGEN_HTML_DIR SITE_OUTPUT_DIR)
    if(NOT DEFINED ${variable} OR "${${variable}}" STREQUAL "")
        message(FATAL_ERROR "Missing documentation path ${variable}")
    endif()
    canonical_directory("${${variable}}" canonical_${variable})
endforeach()
reject_overlap("${canonical_SITE_OUTPUT_DIR}" "${canonical_SITE_SOURCE_DIR}" "the authored site")
reject_overlap("${canonical_SITE_OUTPUT_DIR}" "${canonical_DOXYGEN_HTML_DIR}" "the API documentation")

if(NOT EXISTS "${SITE_SOURCE_DIR}/index.html")
    message(FATAL_ERROR "The user documentation is missing: ${SITE_SOURCE_DIR}/index.html")
endif()
if(NOT EXISTS "${DOXYGEN_HTML_DIR}/index.html")
    message(FATAL_ERROR "The API documentation is missing: ${DOXYGEN_HTML_DIR}/index.html")
endif()

# Start fresh so removed pages and assets cannot survive an incremental build.
file(REMOVE_RECURSE "${SITE_OUTPUT_DIR}")
file(MAKE_DIRECTORY "${SITE_OUTPUT_DIR}")
file(COPY "${SITE_SOURCE_DIR}/" DESTINATION "${SITE_OUTPUT_DIR}")
file(COPY "${DOXYGEN_HTML_DIR}/" DESTINATION "${SITE_OUTPUT_DIR}/api")
file(WRITE "${SITE_OUTPUT_DIR}/.nojekyll" "")

# Preserve published Doxygen page links while the landing page moves to the guide.
file(GLOB legacy_pages RELATIVE "${DOXYGEN_HTML_DIR}" "${DOXYGEN_HTML_DIR}/*.html")
foreach(page IN LISTS legacy_pages)
    if(NOT EXISTS "${SITE_OUTPUT_DIR}/${page}")
        set(redirect_target "api/${page}")
        configure_file("${CMAKE_CURRENT_LIST_DIR}/redirect.html.in" "${SITE_OUTPUT_DIR}/${page}" @ONLY)
    endif()
endforeach()
